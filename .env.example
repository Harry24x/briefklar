# Copy this file to .env and fill in the values. Never commit .env.

# --- Database (local Docker Compose defaults) ---
POSTGRES_USER=briefklar
POSTGRES_PASSWORD=
POSTGRES_DB=briefklar
# Running the backend on your laptop (outside Docker):
DATABASE_URL=postgresql+psycopg://briefklar:CHANGE_ME@localhost:5432/briefklar

# --- LLM (Groq free tier) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# --- Retrieval ---
EMBED_MODEL=intfloat/multilingual-e5-small
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_ENABLED=true
QUERY_REWRITE=false
RETRIEVAL_MODE=hybrid+rerank
# Refuse when the best retrieved chunk scores below these (tuned on the eval set)
MIN_SCORE=-1.0
MIN_VECTOR_SIM=0.0

# --- API ---
CORS_ORIGINS=http://localhost:3000

# --- Tracing (optional) ---
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
